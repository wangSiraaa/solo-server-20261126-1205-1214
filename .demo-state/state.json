 "turns": [
  {
   "id": "turn-0001",
   "label": "v1 · 初版",
   "segments": [
    {
     "id": "ch1",
     "title": "一 · 雨夜归人",
     "text": "雨下了整夜。阿禾拎着一只旧皮箱回到镇口，路灯把水洼照成碎玻璃。有人说过，桥就在镇子东头，可没人告诉她，桥下究竟压着什么。",
     "discloses": [],
     "requires": [],
     "describes": [
      "ch2a",
      "ch2b"
     ]
    },
    {
     "id": "ch2a",
     "title": "二 · 桥下（信）",
     "text": "她在门缝里摸到一封信，邮票是十年前的。信纸泛黄，末尾一行字迹发抖：「钥匙藏在桥下。」落款是一个她以为早已不在人世的名字。",
     "discloses": [
      "key_under_bridge",
      "letter_name"
     ],
     "requires": [],
     "describes": []
    },
    {
     "id": "ch2b",
     "title": "二 · 桥下（录音）",
     "text": "录音机卡了一下，磁带转起来。沙沙声里，一个男人的声音低低地说：「钥匙藏在桥下，别问是谁放的。」那声音她认得，却不敢承认。",
     "discloses": [
      "key_under_bridge",
      "tape_confession"
     ],
     "requires": [],
     "describes": []
    },
    {
     "id": "ch3",
     "title": "三 · 天亮之前",
     "text": "她把钥匙攥在手心，坐到天亮。走哪一条路，得在天亮前决定。",
     "discloses": [
      "dawn_choice"
     ],
     "requires": [
      "key_under_bridge"
     ],
     "describes": []
    },
    {
     "id": "e1",
     "title": "结局 · 重逢",
     "text": "门开了。哥哥站在门后，比记忆里老了许多，手里也是一把锈钥匙。他们没有说话，只是把两把钥匙并在一起。",
     "discloses": [
      "brother_alive"
     ],
     "requires": [
      "key_under_bridge"
     ],
     "describes": []
    },
    {
     "id": "e2",
     "title": "结局 · 空屋",
     "text": "门开了，屋里没有人。桌上留着一杯凉透的茶，和一张写着「对不起」的纸。她把钥匙留在桌上，转身走进清晨。",
     "discloses": [
      "brother_gone"
     ],
     "requires": [
      "key_under_bridge"
     ],
     "describes": []
    }
   ],
   "published_at": 1795696837.3502667,
   "revision_of": null,
   "unchanged_segments": [],
   "carry_facts": [],
   "note": ""
  },
